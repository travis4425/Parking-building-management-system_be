generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Zone {
  id               String            @id(map: "PK__zones__3213E83F60EF673F") @default(cuid()) @db.NVarChar(100)
  name             String            @db.NVarChar(255)
  description      String?           @db.NVarChar(Max)
  floor            Int
  capacity         Int
  status           String?           @default("ACTIVE", map: "DF__zones__status__37A5467C") @db.NVarChar(50)
  createdAt        DateTime?         @default(now(), map: "DF__zones__createdAt__38996AB5")
  updatedAt        DateTime?         @default(now(), map: "DF__zones__updatedAt__398D8EEE") @updatedAt
  gates            Gate[]
  parkingSessions  ParkingSession[]
  parkingSlots     ParkingSlot[]
  reservations     Reservation[]
  zoneVehicleRules ZoneVehicleRule[]

  @@map("zones")
}

model Gate {
  id            String           @id(map: "PK__gates__3213E83F90950D98") @default(cuid()) @db.NVarChar(100)
  name          String           @db.NVarChar(255)
  code          String           @unique(map: "UQ__gates__357D4CF933ED89D1") @db.NVarChar(100)
  type          String           @db.NVarChar(50)
  status        String?          @default("ACTIVE", map: "DF__gates__status__3D5E1FD2") @db.NVarChar(50)
  zoneId        String           @db.NVarChar(100)
  createdAt     DateTime?        @default(now(), map: "DF__gates__createdAt__3E52440B")
  updatedAt     DateTime?        @default(now(), map: "DF__gates__updatedAt__3F466844") @updatedAt
  zone          Zone             @relation(fields: [zoneId], references: [id], onUpdate: NoAction, map: "FK_Gates_Zones")
  entrySessions ParkingSession[] @relation("GateIn")
  exitSessions  ParkingSession[] @relation("GateOut")

  @@map("gates")
}

model VehicleType {
  id               String            @id(map: "PK__vehicle___3213E83F74EC0F58") @default(cuid()) @db.NVarChar(100)
  name             String            @unique(map: "UQ__vehicle___72E12F1BF4B78E3F") @db.NVarChar(100)
  code             String            @unique(map: "UQ__vehicle___357D4CF96CCFC05F") @db.NVarChar(100)
  description      String?           @db.NVarChar(Max)
  maxHeight        Float?
  maxWidth         Float?
  createdAt        DateTime?         @default(now(), map: "DF__vehicle_t__creat__44FF419A")
  updatedAt        DateTime?         @default(now(), map: "DF__vehicle_t__updat__45F365D3") @updatedAt
  parkingSessions  ParkingSession[]
  pricePolicies    PricePolicy[]
  reservations     Reservation[]
  zoneVehicleRules ZoneVehicleRule[]

  @@map("vehicle_types")
}

model ZoneVehicleRule {
  id            String      @id(map: "PK__zone_veh__3213E83FD4D7C90E") @default(cuid()) @db.NVarChar(100)
  zoneId        String      @db.NVarChar(100)
  vehicleTypeId String      @db.NVarChar(100)
  createdAt     DateTime?   @default(now(), map: "DF__zone_vehi__creat__49C3F6B7")
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onUpdate: NoAction, map: "FK_ZVR_VehicleType")
  zone          Zone        @relation(fields: [zoneId], references: [id], onUpdate: NoAction, map: "FK_ZVR_Zone")

  @@unique([zoneId, vehicleTypeId], map: "UQ_ZoneVehicle")
  @@map("zone_vehicle_rules")
}

model ParkingSlot {
  id              String           @id(map: "PK__parking___3213E83F9E5C307A") @default(cuid()) @db.NVarChar(100)
  code            String           @unique(map: "UQ__parking___357D4CF9EA65E474") @db.NVarChar(100)
  zoneId          String           @db.NVarChar(100)
  status          String?          @default("AVAILABLE", map: "DF__parking_s__statu__4F7CD00D") @db.NVarChar(50)
  createdAt       DateTime?        @default(now(), map: "DF__parking_s__creat__5070F446")
  updatedAt       DateTime?        @default(now(), map: "DF__parking_s__updat__5165187F") @updatedAt
  parkingSessions ParkingSession[]
  zone            Zone             @relation(fields: [zoneId], references: [id], onUpdate: NoAction, map: "FK_Slots_Zones")

  @@map("parking_slots")
}

model PricePolicy {
  id             String      @id(map: "PK__price_po__3213E83F320F767F") @default(cuid()) @db.NVarChar(100)
  vehicleTypeId  String      @db.NVarChar(100)
  name           String      @db.NVarChar(255)
  basePrice      Float
  pricePerHour   Float
  peakMultiplier Float?      @default(1.5, map: "DF__price_pol__peakM__5535A963")
  isActive       Boolean?    @default(true, map: "DF__price_pol__isAct__5629CD9C")
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime?   @default(now(), map: "DF__price_pol__creat__571DF1D5")
  updatedAt      DateTime?   @default(now(), map: "DF__price_pol__updat__5812160E") @updatedAt
  vehicleType    VehicleType @relation(fields: [vehicleTypeId], references: [id], onUpdate: NoAction, map: "FK_Price_Vehicle")

  @@map("price_policies")
}

model Reservation {
  id              String           @id(map: "PK__reservat__3213E83F8B36C701") @default(cuid()) @db.NVarChar(100)
  userId          String           @db.NVarChar(100)
  vehicleTypeId   String           @db.NVarChar(100)
  zoneId          String           @db.NVarChar(100)
  startTime       DateTime
  endTime         DateTime
  status          String?          @default("ACTIVE", map: "DF__reservati__statu__5BE2A6F2") @db.NVarChar(50)
  cancelledAt     DateTime?
  createdAt       DateTime?        @default(now(), map: "DF__reservati__creat__5CD6CB2B")
  updatedAt       DateTime?        @default(now(), map: "DF__reservati__updat__5DCAEF64") @updatedAt
  parkingSessions ParkingSession[]
  vehicleType     VehicleType      @relation(fields: [vehicleTypeId], references: [id], onUpdate: NoAction, map: "FK_Reservations_Vehicle")
  zone            Zone             @relation(fields: [zoneId], references: [id], onUpdate: NoAction, map: "FK_Reservations_Zone")

  @@map("reservations")
}

model ParkingSession {
  id            String       @id(map: "PK__parking___3213E83FBBCDDD89") @default(cuid()) @db.NVarChar(100)
  userId        String?      @db.NVarChar(100)
  vehicleTypeId String       @db.NVarChar(100)
  zoneId        String       @db.NVarChar(100)
  slotId        String?      @db.NVarChar(100)
  gateInId      String?      @db.NVarChar(100)
  gateOutId     String?      @db.NVarChar(100)
  licensePlate  String       @db.NVarChar(50)
  ticketCode    String       @unique(map: "UQ__parking___FCC3B001F00F5E1B") @db.NVarChar(100)
  entryTime     DateTime?    @default(now(), map: "DF__parking_s__entry__6383C8BA")
  exitTime      DateTime?
  status        String?      @default("ACTIVE", map: "DF__parking_s__statu__6477ECF3") @db.NVarChar(50)
  reservationId String?      @db.NVarChar(100)
  totalFee      Float?
  paidAt        DateTime?
  createdAt     DateTime?    @default(now(), map: "DF__parking_s__creat__656C112C")
  updatedAt     DateTime?    @default(now(), map: "DF__parking_s__updat__66603565") @updatedAt
  gateIn        Gate?        @relation("GateIn", fields: [gateInId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PS_GateIn")
  gateOut       Gate?        @relation("GateOut", fields: [gateOutId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PS_GateOut")
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PS_Reservation")
  slot          ParkingSlot? @relation(fields: [slotId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_PS_Slot")
  vehicleType   VehicleType  @relation(fields: [vehicleTypeId], references: [id], onUpdate: NoAction, map: "FK_PS_Vehicle")
  zone          Zone         @relation(fields: [zoneId], references: [id], onUpdate: NoAction, map: "FK_PS_Zone")

  @@map("parking_sessions")
}

model AuditLog {
  id         String    @id(map: "PK__audit_lo__3213E83FC5F9F9E3") @default(cuid()) @db.NVarChar(100)
  userId     String    @db.NVarChar(100)
  action     String    @db.NVarChar(255)
  resource   String    @db.NVarChar(255)
  resourceId String?   @db.NVarChar(100)
  oldData    String?   @db.NVarChar(Max)
  newData    String?   @db.NVarChar(Max)
  ipAddress  String?   @db.NVarChar(100)
  createdAt  DateTime? @default(now(), map: "DF__audit_log__creat__6EF57B66")

  @@map("audit_logs")
}

model sysdiagrams {
  name         String @db.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B61900798E6") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model Zone {
  id               String            @id @default(cuid())
  name             String
  description      String?
  floor            Int
  capacity         Int
  status           String?           @default("ACTIVE")
  createdAt        DateTime?         @default(now())
  updatedAt        DateTime?         @default(now()) @updatedAt
  gates            Gate[]
  parkingSessions  ParkingSession[]
  parkingSlots     ParkingSlot[]
  reservations     Reservation[]
  zoneVehicleRules ZoneVehicleRule[]

  @@map("zones")
}

model Gate {
  id            String           @id @default(cuid())
  name          String
  code          String           @unique
  type          String
  status        String?          @default("ACTIVE")
  zoneId        String
  createdAt     DateTime?        @default(now())
  updatedAt     DateTime?        @default(now()) @updatedAt
  zone          Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  entrySessions ParkingSession[] @relation("GateIn")
  exitSessions  ParkingSession[] @relation("GateOut")

  @@map("gates")
}

model VehicleType {
  id               String            @id @default(cuid())
  name             String            @unique
  code             String            @unique
  description      String?
  maxHeight        Float?
  maxWidth         Float?
  createdAt        DateTime?         @default(now())
  updatedAt        DateTime?         @default(now()) @updatedAt
  parkingSessions  ParkingSession[]
  pricePolicies    PricePolicy[]
  reservations     Reservation[]
  zoneVehicleRules ZoneVehicleRule[]

  @@map("vehicle_types")
}

model ZoneVehicleRule {
  id            String      @id @default(cuid())
  zoneId        String
  vehicleTypeId String
  createdAt     DateTime?   @default(now())
  vehicleType   VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  zone          Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@unique([zoneId, vehicleTypeId])
  @@map("zone_vehicle_rules")
}

model ParkingSlot {
  id              String           @id @default(cuid())
  code            String           @unique
  zoneId          String
  status          String?          @default("AVAILABLE")
  createdAt       DateTime?        @default(now())
  updatedAt       DateTime?        @default(now()) @updatedAt
  parkingSessions ParkingSession[]
  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("parking_slots")
}

model PricePolicy {
  id             String      @id @default(cuid())
  vehicleTypeId  String
  name           String
  basePrice      Float
  pricePerHour   Float
  peakMultiplier Float?      @default(1.5)
  isActive       Boolean?    @default(true)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime?   @default(now())
  updatedAt      DateTime?   @default(now()) @updatedAt
  vehicleType    VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)

  @@map("price_policies")
}

model Reservation {
  id              String           @id @default(cuid())
  userId          String
  vehicleTypeId   String
  zoneId          String
  startTime       DateTime
  endTime         DateTime
  status          String?          @default("ACTIVE")
  cancelledAt     DateTime?
  createdAt       DateTime?        @default(now())
  updatedAt       DateTime?        @default(now()) @updatedAt
  parkingSessions ParkingSession[]
  vehicleType     VehicleType      @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("reservations")
}

model ParkingSession {
  id            String       @id @default(cuid())
  userId        String?
  vehicleTypeId String
  zoneId        String
  slotId        String?
  gateInId      String?
  gateOutId     String?
  licensePlate  String
  ticketCode    String       @unique
  entryTime     DateTime?    @default(now())
  exitTime      DateTime?
  status        String?      @default("ACTIVE")
  reservationId String?
  totalFee      Float?
  paidAt        DateTime?
  createdAt     DateTime?    @default(now())
  updatedAt     DateTime?    @default(now()) @updatedAt
  gateIn        Gate?        @relation("GateIn", fields: [gateInId], references: [id], onDelete: SetNull)
  gateOut       Gate?        @relation("GateOut", fields: [gateOutId], references: [id], onDelete: SetNull)
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  slot          ParkingSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  vehicleType   VehicleType  @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  zone          Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("parking_sessions")
}

model AuditLog {
  id         String    @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  oldData    String?
  newData    String?
  ipAddress  String?
  createdAt  DateTime? @default(now())

  @@map("audit_logs")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  fullName  String?
  role      String    @default("DRIVER") // Mặc định là DRIVER (theo middleware của bạn: ADMIN, MANAGER, STAFF, DRIVER)
  createdAt DateTime? @default(now())
  updatedAt DateTime? @default(now()) @updatedAt

  @@map("users")
}
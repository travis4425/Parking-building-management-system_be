generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ================= ENUMS =================
enum Role {
  MANAGER
  STAFF
  DRIVER
  ADMIN
}

enum SlotStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  LOCKED
}

enum PaymentMethod {
  CASH
  QR
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SessionStatus {
  ACTIVE
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
}

enum ExceptionType {
  LOST_TICKET
  WRONG_PLATE
  WRONG_ZONE
}

enum AlertType {
  SENSOR_ERROR
  SESSION_OVERTIME
  WRONG_ZONE
}

enum AlertStatus {
  PENDING
  RESOLVED
}

// ================= MODELS =================

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String
  fullName       String?
  phone          String?
  role           Role      @default(DRIVER)
  status         String    @default("ACTIVE")
  // Driver fields — chỉ có ý nghĩa khi role = DRIVER
  licensePlate   String?   @unique
  vehicleTypeId  String?
  qrToken        String?   @unique  // QR cố định theo account, dùng để check-in/check-out
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicleType  VehicleType?  @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)
  sessions     Session[]
  reservations Reservation[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Zone {
  id          String    @id @default(cuid())
  name        String
  description String?
  floor       Int
  capacity    Int
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  gates            Gate[]
  slots            Slot[]
  sessions         Session[]
  reservations     Reservation[]
  zoneVehicleRules ZoneVehicleRule[]

  @@map("zones")
}

model Gate {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  type      String
  status    String   @default("ACTIVE")
  zoneId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone          Zone      @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  entrySessions Session[] @relation("SessionGateIn")
  exitSessions  Session[] @relation("SessionGateOut")

  @@map("gates")
}

model VehicleType {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  maxHeight   Float?
  maxWidth    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            User[]
  slots            Slot[]
  sessions         Session[]
  pricePolicies    PricePolicy[]
  reservations     Reservation[]
  zoneVehicleRules ZoneVehicleRule[]

  @@map("vehicle_types")
}

model ZoneVehicleRule {
  id            String   @id @default(cuid())
  zoneId        String
  vehicleTypeId String
  createdAt     DateTime @default(now())

  zone        Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)

  @@unique([zoneId, vehicleTypeId])
  @@map("zone_vehicle_rules")
}

model PricePolicy {
  id             String    @id @default(cuid())
  vehicleTypeId  String
  name           String
  basePrice      Float
  pricePerHour   Float
  peakMultiplier Float     @default(1.5)
  overnightRate  Float     @default(20000)
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)

  @@map("price_policies")
}

model Reservation {
  id            String    @id @default(cuid())
  userId        String
  vehicleTypeId String
  zoneId        String
  startTime     DateTime
  endTime       DateTime
  status        String    @default("ACTIVE")
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  zone        Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@map("reservations")
}

model Slot {
  id            String     @id @default(cuid())
  code          String     @unique
  zoneId        String
  vehicleTypeId String?
  status        SlotStatus @default(AVAILABLE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  zone        Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  vehicleType VehicleType? @relation(fields: [vehicleTypeId], references: [id], onDelete: SetNull)
  sessions    Session[]
  alerts      Alert[]

  @@map("slots")
}

model Session {
  id            String        @id @default(cuid())
  userId        String?
  vehicleTypeId String
  zoneId        String
  slotId        String?
  gateInId      String?
  gateOutId     String?
  reservationId String?
  licensePlate  String
  qrToken       String        @unique
  entryTime     DateTime      @default(now())
  exitTime      DateTime?
  status        SessionStatus @default(ACTIVE)
  totalFee      Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleType VehicleType  @relation(fields: [vehicleTypeId], references: [id], onDelete: Cascade)
  zone        Zone         @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  slot        Slot?        @relation(fields: [slotId], references: [id], onDelete: SetNull)
  gateIn      Gate?        @relation("SessionGateIn", fields: [gateInId], references: [id], onDelete: SetNull)
  gateOut     Gate?        @relation("SessionGateOut", fields: [gateOutId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  payment     Payment?
  exceptions  Exception[]

  @@map("sessions")
}

model Payment {
  id              String        @id @default(cuid())
  sessionId       String        @unique
  amount          Float
  paymentMethod   PaymentMethod
  status          PaymentStatus @default(SUCCESS)
  providerTxnRef  String?       // Mã giao dịch từ VNPay / provider bên ngoài
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Exception {
  id              String        @id @default(cuid())
  sessionId       String
  type            ExceptionType
  description     String?
  extraFee        Float?
  oldLicensePlate String?
  newLicensePlate String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("exceptions")
}

model Alert {
  id        String      @id @default(cuid())
  type      AlertType
  slotId    String?
  message   String
  status    AlertStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  slot Slot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@map("alerts")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  oldData    String?
  newData    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  type        String   @default("string")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}
